build: [
  ["dune" "build" "-p" "cohttp-lwt" "-j" jobs "-x" "android" "@install"]
  ["rm" "%{name}%.install"]
]
install: ["dune" "install" "-x" "android" "-p" "cohttp-lwt"]
remove: ["ocamlfind" "-toolchain" "android" "remove" "cohttp-lwt"]

